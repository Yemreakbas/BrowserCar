# BrowserCar Configuration Template
# ==========================================

# 1. CLIENT CONFIGURATION (Vite)
# The full HTTP/HTTPS URL of the authoritative WebSocket multiplayer server.
# In local development: http://localhost:3001
# In production: https://your-server.onrender.com or https://api.yourdomain.com
VITE_SERVER_URL=http://localhost:3001

# 2. SERVER CONFIGURATION (Node.js)
# Port to listen on (assigned automatically by cloud hosts like Railway/Render/Heroku via process.env.PORT)
PORT=3001

# Network interface to bind to (0.0.0.0 binds to all available interfaces for Docker / LAN / Cloud)
HOST=0.0.0.0

# Allowed CORS origins (* for public access, or comma-separated list of domains)
# Example: https://browsercar.vercel.app,https://yourdomain.com
CORS_ORIGIN=*

# Node Environment
NODE_ENV=production
